{
  "version": 2,
  "builds": [
    {
      "src": "index.go",
      "use": "@vercel/go"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "index.go"
    },
    {
      "src": "/(.*)",
      "dest": "index.html"
    }
  ]
}
